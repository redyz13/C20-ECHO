@startuml
' RAD v1.0.0, section 3.4.5.2.3, p. 85
' Navigation graph, not an object lifecycle.
title Helper

state "DashBoard Helper" as Dashboard
state "SessioneAttiva" as Session
state "Disponibilità" as Availability
state "Profilo" as Profile
state "Report SAP" as SAPReport
state "ReportSafeEscalation" as EscalationReport

[*] --> Dashboard

Dashboard --> Session
Dashboard --> Availability
Dashboard --> Profile

Session --> SAPReport
Session --> EscalationReport
