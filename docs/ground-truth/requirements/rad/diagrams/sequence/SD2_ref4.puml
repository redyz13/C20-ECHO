@startuml
' RAD v1.0.0, section 3.4.4.2.2, p. 72
title ref.4 Avvio Sessione di Ascolto e Notifica

actor Caller as C
boundary ":RichiestaAscoltoUI" as UI
control ":RichiestaAscoltoController" as Ctrl
entity "r:RichiestaAscolto" as R
boundary ":HelperDashboard" as HD
actor Helper as H

activate Ctrl

critical [Verifica atomica dell'assegnazione]
    Ctrl -> R : 1 assegnaHelper(idHelper)
    activate R
    R --> Ctrl : 2 statoAggiornato
    deactivate R
end

Ctrl -> Ctrl : 3 ritiraAltrePropostePendenti()
Ctrl -> Ctrl : 4 generaNicknamesSessione()

Ctrl -> HD : 5 avviaCanaleComunicazione(nicknameCaller)
activate HD
HD -> H : 6 mostraCanale(nicknameCaller)
deactivate HD

Ctrl --> UI : 7 notificaPresaInCarico(nicknameHelper)
activate UI
UI --> C : 8 avviaCanale(nicknameHelper)
deactivate UI
deactivate Ctrl
@enduml
