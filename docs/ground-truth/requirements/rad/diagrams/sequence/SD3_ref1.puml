@startuml
' RAD v1.0.0, section 3.4.4.2.3, p. 74
title SD 3 - Gestione del trasferimento esterno

actor Supervisor as S
boundary GestioneEmergenzaUI as UI
control GestioneEscalationControl as Ctrl
control TrasferimentoDatiControl as Transfer
participant "Servizi di emergenza\n(simulati)" as External

note over S, Ctrl
    Il Supervisor ha confermato la presa in carico
    e valuta se sia necessario un trasferimento.
end note

alt [Trasferimento esterno necessario]

    S -> UI : avviaTrasferimento()
    UI -> Ctrl : richiediTrasferimento()
    Ctrl -> Transfer : eseguiTrasferimento()

    loop [Finché la trasmissione non riesce e restano tentativi]

        Transfer -> External : trasmettiDatiDisponibili()

        alt [Trasmissione riuscita]
            External --> Transfer : confermaRicezione()
        else [Errore di trasmissione]
            External --> Transfer : erroreTrasmissione()
            Transfer -> Transfer : preparaNuovoTentativo()
        end
    end

    alt [Dati trasmessi]

        Transfer --> Ctrl : datiTrasmessi()

        alt [Presa in carico esterna confermata]

            External --> Transfer : confermaPresaInCarico()
            Transfer --> Ctrl : presaInCaricoConfermata()
            Ctrl -> UI : notificaPresaInCarico()
            UI -> S : mostraConferma()
            S -> UI : chiudeProcedura()
            UI -> Ctrl : chiudiProcedura()

        else [Presa in carico non confermata]

            Transfer --> Ctrl : presaInCaricoNonConfermata()
            Ctrl -> UI : notificaMancataConferma()
            UI -> S : mostraAvviso()

            note over S, Ctrl
                La procedura rimane aperta
                fino alla presa in carico
                o alla gestione dell'impedimento.
            end note
        end

    else [Tentativi esauriti [Flusso di Errore]]

        Transfer --> Ctrl : trasmissioneFallita()
        Ctrl -> UI : notificaErroreTrasferimento()
        UI -> S : mostraErrore()

        note over S, Ctrl
            Il canale Helper-Caller resta attivo
            e la procedura rimane aperta.
        end note
    end

else [Trasferimento esterno non necessario]

    note over S, Ctrl
        Il Supervisor gestisce la situazione
        senza coinvolgere i servizi esterni.
    end note

    S -> UI : chiudeProcedura()
    UI -> Ctrl : chiudiProcedura()
end
@enduml
