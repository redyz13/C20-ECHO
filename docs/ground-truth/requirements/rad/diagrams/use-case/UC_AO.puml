@startuml
' RAD v1.0.0, section 3.4.2.1, p. 40
title UC_AO: Accesso Ordinario tramite SPID/CIE

actor "Provider SPID/CIE" as Provider
actor Utente
actor Caller
actor Supervisor
actor Helper

Utente <|-- Caller
Utente <|-- Supervisor
Utente <|-- Helper

rectangle "GESTIONE ACCESSO" {
    usecase "Autenticazione con SPID/CIE" as Auth
    usecase "Controllo dell'età minima" as Age
    usecase "Login" as Login
    usecase "Logout" as Logout
}

Provider -- Auth
Utente -- Auth
Utente -- Login
Utente -- Logout

Auth ..> Age : <<include>>
@enduml
